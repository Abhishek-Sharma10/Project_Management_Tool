# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
# Docker host port is 5433 (maps to container port 5432)
DATABASE_URL=postgresql://pmt:YOUR_DB_PASSWORD@localhost:5433/project_management

# JWT — replace with strong random strings in production
JWT_SECRET=replace_with_secure_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_32_chars

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173
